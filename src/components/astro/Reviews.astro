---
interface ReviewItem {
  id: string;
  name: string;
  role: string;
  avatarUrl: string;
  quote: string;
  proofImageUrl: string;
}

const reviews: ReviewItem[] = [
  {
    id: '1',
    name: 'Dr. Ananya & Vikram Malhotra',
    role: 'Grand Wedding Reception • Nov 2024',
    avatarUrl: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=200&q=80',
    quote: 'Hosting our wedding reception at Platinum Resort was the best decision! The banquet decor was breathtaking, the food received endless compliments from all our relatives, and the team handled every detail seamlessly.',
    proofImageUrl: 'https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&w=300&q=80',
  },
  {
    id: '2',
    name: 'Rajesh Singhal',
    role: 'Corporate Annual Gala • Dec 2024',
    avatarUrl: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80',
    quote: 'Outstanding hospitality for our company’s 400-delegate annual conference. The audiovisual setup, banquet catering, and seamless valet management made our event a tremendous success.',
    proofImageUrl: 'https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&w=300&q=80',
  },
  {
    id: '3',
    name: 'Simran Kaur & Family',
    role: 'Sangeet & Ring Ceremony • Jan 2025',
    avatarUrl: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=200&q=80',
    quote: 'The open lawn looked magical with the fairy lights and floral decor for our Sangeet night. The bridal suite was spacious and convenient for all the preparations.',
    proofImageUrl: 'https://images.unsplash.com/photo-1464366400600-7168b8af9bc3?auto=format&fit=crop&w=300&q=80',
  },
];
---

<section id="reviews" class="py-20 lg:py-28 bg-[#0A0A0C] border-t border-white/5 relative overflow-hidden">
  <!-- Subtle Background Glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-gradient-to-t from-[#D4AF37]/5 to-transparent blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center space-y-4 max-w-3xl mx-auto mb-16">
      <span class="review-fade text-[11px] sm:text-xs font-bold tracking-[0.25em] text-[#D4AF37] uppercase">
        Client Testimonials
      </span>
      <h2 class="review-fade font-serif font-bold text-3xl sm:text-4xl lg:text-5xl text-white tracking-tight">
        Real Experiences
      </h2>
      <p class="review-fade text-sm sm:text-base text-neutral-400 font-light leading-relaxed">
        From grand weddings to corporate galas, discover how our dedicated hospitality team and bespoke catering elevate every celebration.
      </p>
    </div>

    <!-- 3-Column Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {reviews.map((review) => (
        <div class="review-card bg-[#111216] border border-white/10 rounded-2xl p-6 sm:p-7 flex flex-col justify-between hover:border-[#D4AF37]/40 hover:-translate-y-1 transition-all duration-300 shadow-xl group">
          
          <div>
            <!-- Author Header -->
            <div class="flex items-center gap-3.5 mb-5">
              <div class="relative w-12 h-12 rounded-full overflow-hidden border border-[#D4AF37]/60 flex-shrink-0">
                <img
                  src={review.avatarUrl}
                  alt={review.name}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div>
                <h3 class="font-serif font-bold text-base text-white group-hover:text-[#F5E8C7] transition-colors">
                  {review.name}
                </h3>
                <p class="text-[11px] text-[#A1A3B0] font-medium tracking-wide">
                  {review.role}
                </p>
              </div>
            </div>

            <!-- Star Rating Row -->
            <div class="flex items-center gap-1 text-[#D4AF37] mb-4">
              {Array.from({ length: 5 }).map(() => (
                <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            <!-- Quote Text -->
            <p class="text-xs sm:text-sm text-neutral-300 font-light leading-relaxed italic">
              "{review.quote}"
            </p>
          </div>

          <!-- Social Proof Thumbnail Badge -->
          <div class="mt-8 pt-4 border-t border-white/5 flex items-center justify-between">
            <span class="text-[10px] font-semibold tracking-widest text-[#A1A3B0] uppercase">
              Guest Photo Proof
            </span>
            <div class="w-10 h-10 rounded-lg overflow-hidden border border-white/15 bg-neutral-800 flex-shrink-0 group-hover:scale-105 transition-transform duration-300">
              <img
                src={review.proofImageUrl}
                alt="Guest celebration moment"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
